# Global npm packages — the npm equivalent of ~/.Brewfile.
#
# One package per line. Blank lines and `#` comments are ignored.
# Append `@version` to pin; bare names track latest.
#
# Regenerate with `npm-globals dump`, install with `npm-globals install`.
# `npm` is omitted on purpose: it ships with Node itself. `corepack` does NOT
# any more (Node 25 dropped it from the distribution), so it is listed below.
#
# Claude Code is deliberately absent: it is installed as the Homebrew cask
# `claude-code` (see ~/.Brewfile), never through npm.
#
# NOTE: globals are installed per Node version under nvm. After
# `nvm install <version>`, re-run `npm-globals install` for that version.

@aws/agentcore
@earendil-works/pi-coding-agent
@google/gemini-cli
@google/jules
@tailwindcss/language-server
@vue/language-server
aws-cdk
bash-language-server
corepack
eslint
intelephense
prettier
prettier-plugin-svelte
svelte-language-server
ts-node
tsx
typescript
typescript-language-server
vscode-langservers-extracted

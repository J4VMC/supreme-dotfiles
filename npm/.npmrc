# ~/dotfiles/npm/.npmrc  →  stowed to ~/.npmrc
#
# THIS REPOSITORY IS PUBLIC. Never put a credential in this file.
#
# ~/.npmrc is npm's user config, which is also where `npm login` writes its
# auth token — so once this file is stowed, logging in would drop a secret
# straight into the working tree. If you ever need a token, reference it
# indirectly instead of pasting it:
#
#     //registry.npmjs.org/:_authToken=${NPM_TOKEN}
#
# npm expands ${VAR} from the environment when it reads this file, so the secret
# itself stays outside the repository. The pre-commit hook in lefthook.yml
# rejects credential-looking lines here as a backstop.

# npm 12 blocks a package's install scripts unless the package is listed here;
# earlier versions only warned. @google/jules and @anthropic-ai/claude-code both
# rely on a postinstall step to fetch their native binary, and without this the
# installed CLI fails at startup with "native binary not installed".
#
# `maintain` runs `npm update -g` daily, so this has to be persistent config —
# a one-off `npm install -g --allow-scripts=...` gets undone by the next run.
allow-scripts=@google/jules,@anthropic-ai/claude-code

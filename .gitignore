# macOS. Written with the real casing: this repo matches only because
# core.ignorecase is true on a case-insensitive volume, and .DS_STORE would
# stop matching on a case-sensitive filesystem.
.DS_Store

# Client-specific scripts are hardcoded against named clients, and this
# repository is public — keep them local and out of every commit. Generic,
# client-free tools are re-included one by one below; anything not named
# stays ignored by default.
bin/bin/*
!bin/bin/chrome-route

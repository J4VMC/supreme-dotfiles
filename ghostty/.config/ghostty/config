shell-integration = fish
shell-integration-features = no-cursor
# Fish comes from Homebrew, whose prefix depends on the CPU: /opt/homebrew on
# Apple silicon, /usr/local on Intel. When Ghostty is launched from the Dock or
# Finder it inherits launchd's minimal PATH, which on Apple silicon does not
# include /opt/homebrew/bin -- so a bare `command = fish` only ever worked on
# Intel, where /usr/local/bin is in /etc/paths. On macOS Ghostty runs the
# value as `login -flp $USER /bin/bash --noprofile --norc -c "exec -l <value>"`,
# and bash's `exec -l` takes ONE program, so the probing loop has to be wrapped
# in its own `/bin/sh -c '...'`. That sh picks whichever fish exists and execs
# it as a login shell (-l, so path_helper runs, as it would for a plain `fish`
# command). If neither exists it falls back to the account's login shell
# instead of a dead window.
command = /bin/sh -c 'for f in /opt/homebrew/bin/fish /usr/local/bin/fish; do test -x "$f" && exec "$f" -l; done; exec "$SHELL" -l'

font-family = "FiraCode Nerd Font"
font-size = 14
font-feature = "liga"
font-feature = "calt"
font-feature = "zero"
font-feature = "fracs"

theme = "Gruvbox Dark Hard"
cursor-style = "underline"
cursor-style-blink = true

background-opacity = 0.85
background-blur = true

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# Keyboard / macOS
# Option sends Meta/Alt so M-x, M-f, M-b etc. work in terminal Emacs (emacsclient -t).
macos-option-as-alt = true

# Color / display
# The built-in panel is wide-gamut P3; render in P3 for richer, accurate color.
window-colorspace = display-p3

# Clipboard
# Selections go straight to the macOS system pasteboard (default only fills the middle-click buffer).
copy-on-select = clipboard
# Allow programs to read the clipboard without a prompt (e.g. OSC-52 paste from Emacs/tmux over SSH).
clipboard-read = allow

# Quality of life
mouse-hide-while-typing = true
window-save-state = always
resize-overlay = never

# Global dropdown "scratch" terminal: cmd+` from anywhere (needs Accessibility permission).
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top

# Typography
font-thicken = true
adjust-cell-height = 10%

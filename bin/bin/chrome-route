#!/bin/sh
# =============================================================================
# chrome-route --- context-aware, URL-routing Chrome launcher
# =============================================================================
#
# Commentary:
# Per-client .envrc files export BROWSER pointing here, so every CLI that
# opens a login URL (aws sso login, gh auth login, ...) goes through this
# script instead of whatever Chrome profile happens to be frontmost.
#
# This script contains no client names and no profile directories. Both live
# outside the repo:
#
#   * Context:  $CHROME_ROUTER_CONTEXT, falling back to $CLIENT_NAME
#     (lowercased), falling back to "default". The client .envrc files
#     already export CLIENT_NAME, so most contexts need no extra wiring.
#
#   * Rules:    ~/.config/chrome-router/<context>.conf, lines of
#                   host-pattern [more-patterns...] = Profile Display Name
#     First matching line wins; use a lone "*" as the catch-all. Patterns
#     are shell globs matched against the URL's bare host. "#" starts a
#     comment.
#
#   * Profile:  the name from the rules file is resolved to Chrome's
#     directory name (Default, Profile 1, ...) at launch time by reading
#     Chrome's Local State, so profiles can be renumbered or recreated
#     without touching any config here. It matches the profile's display
#     name, its Google account name, or the account e-mail. A rule may
#     also name the directory itself ("= Profile 2"), which skips Local
#     State entirely -- the way out when macOS refuses the read (see below).
#     $CHROME_ROUTER_LOCAL_STATE overrides the Local State path (Chrome
#     Beta/Canary/Chromium keep theirs elsewhere).
#
# Since macOS 15, Chrome's data directory is TCC-protected: a terminal app
# reading it gets "Operation not permitted" until the user allows it (the
# "access data from other apps" prompt, or Full Disk Access). That failure
# is reported as such, distinct from "no such profile", because the two
# need different fixes.
#
# Only the FIRST URL a tool hands over needs routing: subsequent SSO
# redirects happen inside whatever profile window was opened.
#
# Fail open: if the context has no rules file, or the profile name does not
# resolve, fall back to plain Chrome (with a warning) rather than eating the
# auth URL.
# =============================================================================

url="$1"

# Reduce the URL to its bare host, so matching text in a path or query
# string can't select the wrong profile.
host="${url#*://}"
host="${host%%/*}"
host="${host%%\?*}"
host="${host%%:*}"

# --- Context -----------------------------------------------------------------
context="${CHROME_ROUTER_CONTEXT:-}"
if [ -z "$context" ] && [ -n "${CLIENT_NAME:-}" ]; then
    context=$(printf '%s' "$CLIENT_NAME" | tr '[:upper:]' '[:lower:]')
fi
context="${context:-default}"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/chrome-router/$context.conf"

# --- Rules: first matching host pattern wins ---------------------------------
profile_name=""
if [ -f "$conf" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        case "$line" in *=*) ;; *) continue ;; esac
        patterns="${line%%=*}"
        name="${line#*=}"
        # Trim surrounding whitespace from the profile name.
        name="${name#"${name%%[![:space:]]*}"}"
        name="${name%"${name##*[![:space:]]}"}"
        # Word-split the patterns with globbing off, so *.example.com
        # cannot expand against files in the current directory.
        set -f
        for pattern in $patterns; do
            case "$host" in
                $pattern) profile_name="$name"; set +f; break 2 ;;
            esac
        done
        set +f
    done < "$conf"
else
    echo "chrome-route: no rules file $conf; opening without a profile" >&2
fi

# --- Resolve profile name -> profile directory from Chrome's Local State ------
profile_dir=""
if [ -n "$profile_name" ]; then
    case "$profile_name" in
        # Already a directory name: nothing to look up.
        Default|Profile\ [0-9]*) profile_dir="$profile_name" ;;
        *)
            profile_dir=$(python3 - "$profile_name" <<'EOF'
import json, os, sys
name = sys.argv[1]
state = os.environ.get("CHROME_ROUTER_LOCAL_STATE") or os.path.expanduser(
    "~/Library/Application Support/Google/Chrome/Local State")
try:
    with open(state) as f:
        info = json.load(f)["profile"]["info_cache"]
except OSError as err:
    # EPERM here is macOS refusing this terminal access to Chrome's data;
    # ENOENT means Chrome has never run. Neither is "no such profile".
    print("chrome-route: cannot read %s: %s" % (state, err.strerror), file=sys.stderr)
    sys.exit(2)
except (KeyError, ValueError):
    print("chrome-route: %s holds no profile list" % state, file=sys.stderr)
    sys.exit(2)
for directory, meta in info.items():
    if name in (meta.get("name"), meta.get("gaia_name"), meta.get("user_name")):
        print(directory)
        sys.exit(0)
known = ", ".join(sorted(m.get("name") or d for d, m in info.items()))
print("chrome-route: no Chrome profile named '%s'; Chrome has: %s" % (name, known), file=sys.stderr)
sys.exit(1)
EOF
            )
            ;;
    esac
    if [ -z "$profile_dir" ]; then
        echo "chrome-route: profile '$profile_name' unresolved (context: $context); opening without a profile" >&2
    fi
fi

if [ -n "$profile_dir" ]; then
    exec open -na "Google Chrome" --args --profile-directory="$profile_dir" "$@"
fi
exec open -na "Google Chrome" --args "$@"

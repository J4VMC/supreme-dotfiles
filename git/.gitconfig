[init]
    defaultBranch = main

[core]
    excludesfile = ~/.gitignore_global
    pager = delta
    # Global hooks directory. commit-msg strips AI assistant attribution
    # trailers; every hook then hands off to `lefthook run <hook>` when the
    # repository has a lefthook.yml. A global core.hooksPath disables the
    # per-repo .git/hooks entirely, and lefthook refuses `lefthook install`
    # under a custom hooks path, so the hand-off is the only way project
    # lefthook configs run at all -- never `lefthook install --force` here,
    # it would overwrite these hooks for every repository on the machine.
    hooksPath = ~/.config/git/hooks

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

# --- SSH Commit Signing ---
[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    # Only consulted when VERIFYING signatures (git log --show-signature,
    # git verify-commit); signing works without it. One line per identity:
    #     <email> <contents of the .pub key>
    allowedSignersFile = ~/.ssh/allowed_signers

[user]
    # Set your default/personal public key here
    signingkey = ~/.ssh/id_ed25519.pub
    # No name/email here on purpose: they live in ~/.gitconfig.local (see the
    # [include] at the bottom). With useConfigOnly git refuses to guess an
    # identity from the login name and hostname, so until that file exists
    # every commit fails with "user.useConfigOnly set but no name given".
    useConfigOnly = true

# --- Delta & Diffs ---
[diff "elpaca-lock"]
    # This regex pulls the package name into the hunk header
    xfuncname = "^[[:space:]\\(]\\(([a-zA-Z0-9_-]+)[[:space:]].*$"

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    # `features = gruvbox` used to sit here. delta's `features` names
    # [delta "<name>"] sections of this file, and no such section existed, so
    # it was a silent no-op and diffs rendered in delta's default Monokai.
    # The theme is a bat/syntect syntax theme (`delta --list-syntax-themes`).
    syntax-theme = gruvbox-dark

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[submodule]
    recurse = true

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential

# Machine-local & per-client overrides. This MUST stay the last section: git
# applies config in file order, so anything below an [include] would win over
# ~/.gitconfig.local. Whatever that file sets (identities, signing keys,
# per-directory includeIf routing for client work areas, a different
# credential helper) always overrides the committed defaults above. The
# .local file is untracked by design: client names and work identities
# never appear in this repository.
[include]
    path = ~/.gitconfig.local
